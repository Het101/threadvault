{
  "name": "threadvault",
  "version": "0.1.0",
  "description": "Mirror Azure Communication Services chat into Postgres so the ACS resource is disposable.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "threadvault": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Het101/threadvault.git"
  },
  "keywords": [
    "azure",
    "acs",
    "communication-services",
    "chat",
    "postgres",
    "migration",
    "archive"
  ],
  "author": "Het Patel",
  "license": "Apache-2.0",
  "dependencies": {
    "@azure/communication-chat": "^1.6.0",
    "@azure/communication-common": "^2.4.0",
    "@azure/communication-identity": "^1.3.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
