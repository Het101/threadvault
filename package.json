{
  "name": "threadvault",
  "version": "0.2.4",
  "description": "Mirror Azure Communication Services chat into Postgres so the ACS resource is disposable.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "threadvault": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "hooks": "git config core.hooksPath .githooks",
    "prepare": "node -e \"const f=require('fs');if(f.existsSync('.githooks')){try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}}\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Het101/threadvault.git"
  },
  "keywords": [
    "azure",
    "acs",
    "communication-services",
    "chat",
    "postgres",
    "migration",
    "archive"
  ],
  "author": "Het Patel",
  "license": "Apache-2.0",
  "dependencies": {
    "@azure/communication-chat": "^1.6.0",
    "@azure/communication-common": "^2.4.0",
    "@azure/communication-identity": "^1.3.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.11.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "bugs": {
    "url": "https://github.com/Het101/threadvault/issues"
  },
  "homepage": "https://github.com/Het101/threadvault#readme"
}
