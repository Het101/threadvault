#!/bin/sh
# Threadvault pre-commit. Wired up by `npm install` via the prepare script
# (git config core.hooksPath .githooks). Run `git commit --no-verify` to skip,
# but CI runs the same checks, so skipping only moves the failure later.
set -e

fail() {
  echo ""
  echo "pre-commit: $1" >&2
  echo ""
  exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# --- 1. Secrets and PHI must never enter the history -------------------------
# These are the rules the whole tool exists to protect. A commit is the last
# cheap place to catch them; after a push to a public repo it is too late.

# .env and .env.<anything>, except the templates that are meant to be committed.
# The first cut caught .env.example itself, which is the one .env file this repo
# has always shipped — a check that blocks the correct thing teaches people to
# pass --no-verify, which costs more than it saves.
if echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -qvE '\.env\.(example|sample|template|dist)$'; then
  fail "refusing to commit a .env file. Use .env.example with placeholders."
fi

added=$(git diff --cached --unified=0 -- $(echo "$staged" | tr '\n' ' ') 2>/dev/null | grep '^+' || true)

# Match on the SHAPE of a real secret, not on an allowlist of placeholders.
# An allowlist has to be extended every time someone writes documentation, and a
# check that cries wolf is a check people learn to bypass. A real ACS key is
# long base64; <key>, $ACS_KEY and a grep pattern in this file are not.
if echo "$added" | grep -qE 'accesskey=[A-Za-z0-9+/]{20,}={0,2}'; then
  fail "an ACS access key looks like it is being committed. Reference it by env var name."
fi

# postgres://user:password@host. A placeholder such as :pass@ or :password@ is
# short; anything ten characters or longer is treated as the real thing.
if echo "$added" | grep -qE '(postgres|postgresql)://[^:/@[:space:]]+:[A-Za-z0-9!#%^&*_+=~.-]{10,}@'; then
  fail "a database URL with a live password looks like it is being committed."
fi

# An npm token. The project's .npmrc is committed, so `npm config set` aimed at
# the wrong file puts a publish credential in a public repo. npm tokens are
# npm_<36 chars>, or a UUID against a registry line in an .npmrc.
if echo "$added" | grep -qE 'npm_[A-Za-z0-9]{36}'; then
  fail "an npm token looks like it is being committed. Put it in your user ~/.npmrc, never here."
fi
if echo "$added" | grep -qE '_authToken[[:space:]]*=[[:space:]]*[^$][^[:space:]]{8,}'; then
  fail "an _authToken value looks like it is being committed. Reference it as \${NPM_TOKEN} instead."
fi

# --- 2. The code has to actually work ----------------------------------------
if echo "$staged" | grep -qE '\.(ts|json)$'; then
  echo "pre-commit: lint"
  npm run --silent lint

  echo "pre-commit: typecheck"
  npm run --silent typecheck

  echo "pre-commit: tests"
  npm run --silent test
fi

exit 0
