# Copy to .env. Threadvault never prints these values: access keys and database
# passwords are stripped from every log line, error and --json payload.
#
# Values here need no quoting. In a shell they do:
#   export ACS_CONNECTION_STRING='endpoint=...;accesskey=...'
# Without the quotes your shell ends the command at the ';' and the key is
# silently dropped.

# --- Required by most commands ------------------------------------------------

# The ACS resource you are inspecting, mirroring or writing to.
# ACS_NEW_CONNECTION_STRING and AZURE_COMMUNICATION_CONNECTION_STRING are also
# read, in that order, if this one is unset.
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>

# Postgres. Used by doctor, mirror backfill, and any --from-mirror command.
DATABASE_URL=postgres://user:pass@localhost:5432/threadvault

# Required by every command that WRITES to ACS: migrate apply, migrate rehearse.
# The resource GUID from 8:acs:<this>_<user>. Discover it with `threadvault probe`.
# The write refuses without it, probes the target, and refuses again on mismatch.
ACS_EXPECT_RESOURCE=

# --- Optional -----------------------------------------------------------------

# Retries through ACS throttling. retry-after is honoured when ACS sends it.
# Permission and not-found errors fail at once rather than backing off.
# ACS_RETRY_ATTEMPTS=8

# TLS certificate verification is ON by default for remote Postgres. Set this
# only for a private CA you cannot add to the system trust store — that
# connection carries credentials and message bodies.
# PG_SSL_NO_VERIFY=false

# Postgres connection retries, with backoff.
# PG_CONNECT_ATTEMPTS=5

# Pinned DNS, as comma-separated host=address pairs. For environments where
# resolution is unreliable or split-horizon.
# PG_HOST_OVERRIDE=db.example.postgres.database.azure.com=10.0.0.4

# --- Not environment variables ------------------------------------------------
#
# The replay ledger is a flag, not a variable: `migrate apply --state replay.jsonl`.
# Back that file up. It holds every minted identity and each thread's progress,
# and it is the only link between the replayed threads and the people in them.
