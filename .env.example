# Copy to .env. Threadvault never prints these values.

# Postgres. One database per invocation.
DATABASE_URL=postgres://user:pass@localhost:5432/threadvault

# ACS connection string of the resource you are inspecting or mirroring.
# Prefer a dedicated name so this does not silently retarget a running app.
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>

# Required for any command that WRITES to ACS (migrate apply / rehearse).
# The resource GUID inside 8:acs:<this>_<user>. Discover it with `threadvault probe`.
ACS_EXPECT_RESOURCE=

# Optional. Source resource for migrate extract, if different from ACS_CONNECTION_STRING.
# ACS_OLD_CONNECTION_STRING=
# ACS_NEW_CONNECTION_STRING=

# Optional. Honour retry-after; default 8.
# ACS_RETRY_ATTEMPTS=8

# Optional. Azure Postgres Flexible Server TLS. Set true to pin the system trust store.
# PG_SSL_VERIFY=false
